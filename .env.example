# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
# Read only by the server. Never prefix these with NEXT_PUBLIC_: that would build
# them into the JavaScript sent to browsers.

# Required for live voice. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults shown.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin

# Optional: long-term memory through Jamak AI Core (the jamak-ai-core project).
# Jamak works without it, just without remembering earlier conversations.
# Where the AI Core runs.
# AI_CORE_URL=http://localhost:8000
# One of the AI Core's API_KEYS.
# AI_CORE_API_KEY=
# Whose memories these are. A fixed id while Jamak has a single user.
# JAMAK_USER_ID=
