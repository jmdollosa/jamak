# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
# Read only by the server (app/api/realtime/session/route.ts). Never prefix these
# with NEXT_PUBLIC_: that would build them into the JavaScript sent to browsers.

# Required for live voice. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults shown.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
